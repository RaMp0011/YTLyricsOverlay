{
  "manifest_version": 3,
  "name": "YouTube Music Lyrics Bridge",
  "version": "1.5.0",
  "description": "Connects YouTube Music playback to the desktop overlay.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "dist/page.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
