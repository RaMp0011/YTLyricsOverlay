{
  "name": "lyrics-overlay",
  "private": true,
  "version": "0.1.0",
  "description": "Synced lyrics for YouTube Music in a floating desktop overlay.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "build:extension": "esbuild extension/content.ts extension/page.ts extension/background.ts --bundle --outdir=extension/dist --platform=browser --format=iife",
    "package:extension": "npm run build:extension && node scripts/package-extension.mjs",
    "release": "npm run build && npm run package:extension"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "main": "dist-electron/main.js"
}
